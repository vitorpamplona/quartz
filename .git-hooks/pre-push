#!/bin/bash

GREEN='\033[0;32m'
NO_COLOR='\033[0m'

echo "*********************************************************"
echo "Running git pre-push hook."
echo "*********************************************************"
echo ""
echo "Java Version: "
echo "$JAVA_HOME"
echo "$(java -version)"
echo "Running test... "

# Every module's JVM tests (the same suite CI's test-jvm job runs). Each module
# forks its own test JVM, so cloud sessions and other small machines run two at
# a time to stay inside their memory.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
    ./gradlew jvmTest --max-workers=2 --quiet
else
    ./gradlew jvmTest --quiet
fi
status=$?

if [ "$status" = 0 ] ; then
    echo "All test passed."
    exit 0
else
    echo "*********************************************************"
    echo 1>&2 "Failing test"
    printf "Run ${GREEN}./gradlew jvmTest${NO_COLOR} to make sure you have all tests green before pushing...\n"
    echo "*********************************************************"
    exit 1
fi
